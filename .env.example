OPENAI_API_KEY=your_api_key_here
# IMPORTANT: "gpt-5.6-luna" is a placeholder, not a real OpenAI model name.
# Set this to a real model in your OpenAI account that supports the
# Responses API's web_search tool, or Research will fail even with a valid key.
SAARTHI_MODEL=gpt-5.6-luna
SAARTHI_DEMO_MODE=true
SAARTHI_CORS_ORIGIN=http://localhost:3000
