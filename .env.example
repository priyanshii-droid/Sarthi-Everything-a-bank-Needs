# Required for live web research and optional AI reasoning
OPENAI_API_KEY=your_api_key_here

# OpenAI model used by Saarthi
SAARTHI_MODEL=gpt-5.6-luna

# Local development defaults
PORT=3000
SAARTHI_DEMO_MODE=true
SAARTHI_CORS_ORIGIN=http://localhost:3000
SAARTHI_RATE_LIMIT=120
SAARTHI_AUTH_SESSION_DAYS=30
